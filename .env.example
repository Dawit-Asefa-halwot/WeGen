# ==========================================
# WEGEN PLATFORM ENVIRONMENT CONFIGURATION
# ==========================================

# ------------------------------------------
# Environment & App Settings
# ------------------------------------------
NODE_ENV=development
PORT=4000
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------
# PostgreSQL Database (Prisma)
# ------------------------------------------
DATABASE_URL="postgresql://wegen_user:wegen_secret_pass@localhost:5432/wegen_db?schema=public"
DIRECT_DATABASE_URL="postgresql://wegen_user:wegen_secret_pass@localhost:5432/wegen_db?schema=public"

# ------------------------------------------
# Redis (Cache & BullMQ)
# ------------------------------------------
REDIS_URL="redis://localhost:6379"

# ------------------------------------------
# Auth & JWT Secrets
# ------------------------------------------
JWT_SECRET=super_secret_jwt_access_token_key_change_in_production_32bytes
JWT_EXPIRES_IN=1d
JWT_REFRESH_SECRET=super_secret_jwt_refresh_token_key_change_in_production_32bytes
JWT_REFRESH_EXPIRES_IN=7d

# ------------------------------------------
# S3 / Object Storage (Media & Verification Docs)
# ------------------------------------------
STORAGE_DRIVER=local # local | s3
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_BUCKET=wegen-uploads
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin

# ------------------------------------------
# Payment Provider Abstraction Credentials
# ------------------------------------------
PAYMENT_PROVIDER_DEFAULT=chapa # chapa | telebirr | cbe | mock
CHAPA_SECRET_KEY=CHASECK_TEST-xxxxxxx
CHAPA_PUBLIC_KEY=CHAPUBK_TEST-xxxxxxx
CHAPA_WEBHOOK_SECRET=chapa_webhook_secret_key_test
TELEBIRR_APP_ID=xxxxxxx
TELEBIRR_APP_KEY=xxxxxxx
TELEBIRR_SHORT_CODE=xxxxxxx
TELEBIRR_PUBLIC_KEY=xxxxxxx

# ------------------------------------------
# SMTP Email Settings
# ------------------------------------------
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=test_user
SMTP_PASS=test_pass
EMAIL_FROM="WeGen Ethiopia <noreply@wegen.et>"
